{
  "name": "scanbotsdk",
  "version": "0.800.3",
  "description": "Node.js wrapper for Scanbot SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=14.21"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "dist",
    "scripts",
    "LICENSE",
    "Libraries.txt"
  ],
  "scripts": {
    "generate-exports": "barrelsby --directory lib --outFile lib/index.ts --exclude lib/index.ts --noHeader --delete",
    "build": "npm run generate-exports && tsc",
    "prepublishOnly": "npm run build",
    "postinstall": "npm install download && node scripts/DownloadBinary.js"
  },
  "author": "Scanbot SDK GmbH",
  "license": "Commercial",
  "homepage": "https://scanbot.io",
  "contributors": [
    {
      "name": "Scanbot",
      "email": "sdk@scanbot.io",
      "url": "https://scanbot.io"
    }
  ],
  "devDependencies": {
    "@types/node": "^24.1.0",
    "barrelsby": "^2.8.1",
    "download": "^8.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
